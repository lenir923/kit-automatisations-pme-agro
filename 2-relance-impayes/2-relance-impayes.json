    {
      "id": "af02aa22-0198-4c7e-b54b-9ed373f3d92a",
      "name": "Mail poli",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1580,
        -140
      ],
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=Facture {{ $json.n_facture }} : petit rappel",
        "emailType": "text",
        "message": "=Bonjour,\n\nSauf erreur de notre part, la facture du {{ $json.date_facture_texte }} ({{ $json.n_facture }}, {{ $json.montant_texte }} TTC) est arrivée à échéance {{ $json.echeance_texte }}.\n\nSi le règlement est déjà parti, merci d'ignorer ce message.\n\nBonne journée,\n\n{{ $('Réglages').first().json.signature }}",
        "options": {
          "appendAttribution": false,
          "senderName": "={{ $('Réglages').first().json.nom_entreprise }}"
        }
      }
    },
    {
      "id": "c2a8f234-4c0b-4fda-a399-da2e1b77e838",
      "name": "Joindre la facture PDF",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1380,
        20
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Joint la facture en PDF.\n// Ici on la fabrique à partir du tableau. Chez vous : le PDF de votre logiciel de facturation.\nconst R = $('Réglages').first().json;\nconst f = $json;\nconst fr = d => d ? DateTime.fromISO(d).setLocale('fr').toFormat('dd/MM/yyyy') : '';\n\n// Texte compatible PDF (accents en WinAnsi)\nconst pdfTexte = s => String(s)\n  .replace(/[  ]/g, ' ')\n  .replace(/[\\\\()]/g, c => '\\\\' + c)\n  .replace(/[^\\x20-\\x7e]/g, c => {\n    const code = c === '€' ? 0x80 : c === '’' ? 0x92 : c.charCodeAt(0);\n    return code < 256 ? '\\\\' + code.toString(8).padStart(3, '0') : '?';\n  });\n\nconst lignes = [\n  [50, 780, 20, 'F2', R.nom_entreprise],\n  [50, 762, 10, 'F1', R.adresse_entreprise],\n  [50, 690, 18, 'F2', `FACTURE ${f.n_facture}`],\n  [50, 655, 11, 'F1', `Client : ${f.client} (${f.id_client})`],\n  [50, 637, 11, 'F1', `Date de facture : ${fr(f.date_facture)}`],\n  [50, 619, 11, 'F1', `Date d'échéance : ${fr(f.date_echeance)}`],\n  [50, 570, 14, 'F2', `Montant TTC : ${f.montant_texte}`],\n  [50, 548, 11, 'F1', `Reste à payer : ${f.montant_texte}`],\n  [50, 500, 10, 'F1', `Règlement par virement, en indiquant le numéro de facture ${f.n_facture}.`],\n  [50, 60, 8, 'F1', 'Facture de démonstration.'],\n];\nconst contenu = lignes.map(([x, y, t, police, s]) => `BT /${police} ${t} Tf ${x} ${y} Td (${pdfTexte(s)}) Tj ET`).join('\\n');\n\nconst objets = [\n  '<< /Type /Catalog /Pages 2 0 R >>',\n  '<< /Type /Pages /Kids [3 0 R] /Count 1 >>',\n  '<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Resources << /Font << /F1 4 0 R /F2 5 0 R >> >> /Contents 6 0 R >>',\n  '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>',\n  '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding >>',\n  `<< /Length ${contenu.length} >>\\nstream\\n${contenu}\\nendstream`,\n];\nlet pdf = '%PDF-1.4\\n';\nconst positions = [];\nobjets.forEach((o, i) => { positions.push(pdf.length); pdf += `${i + 1} 0 obj\\n${o}\\nendobj\\n`; });\nconst xref = pdf.length;\npdf += `xref\\n0 ${objets.length + 1}\\n0000000000 65535 f \\n`;\npositions.forEach(p => { pdf += `${String(p).padStart(10, '0')} 00000 n \\n`; });\npdf += `trailer\\n<< /Size ${objets.length + 1} /Root 1 0 R >>\\nstartxref\\n${xref}\\n%%EOF`;\n\nreturn {\n  json: f,\n  binary: {\n    facture: {\n      data: Buffer.from(pdf, 'latin1').toString('base64'),\n      mimeType: 'application/pdf',\n      fileName: `Facture-${f.n_facture}.pdf`,\n      fileExtension: 'pdf',\n    },\n  },\n};\n"
      }
    },
    {
      "id": "b2893917-074a-416c-a703-f949d61b121b",
      "name": "Rappel direct + facture",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1580,
        20
      ],
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=Rappel : facture {{ $json.n_facture }} en attente de règlement",
        "emailType": "text",
        "message": "=Bonjour,\n\nNous n'avons pas encore reçu le règlement de la facture {{ $json.n_facture }} du {{ $json.date_facture_texte }}, d'un montant de {{ $json.montant_texte }} TTC. Elle est échue depuis le {{ $json.date_echeance_texte }}, soit {{ $json.jours_retard }} jours de retard.\n\nVous la trouverez en pièce jointe. Merci de procéder au règlement dans les prochains jours.\n\nSi le paiement est en cours, un simple retour à ce mail nous suffit.\n\nCordialement,\n\n{{ $('Réglages').first().json.signature }}",
        "options": {
          "appendAttribution": false,
          "senderName": "={{ $('Réglages').first().json.nom_entreprise }}",
          "attachmentsUi": {
            "attachmentsBinary": [
              {
                "property": "facture"
              }
            ]
          }
        }
      }
    },
    {
      "id": "08d98b8f-f6a5-4ed4-8252-b6eaf322a268",
      "name": "Mail ferme",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1580,
        200
      ],
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=Facture {{ $json.n_facture }} impayée : merci de nous donner une date de paiement",
        "emailType": "text",
        "message": "=Bonjour,\n\nMalgré nos rappels, la facture {{ $json.n_facture }} du {{ $json.date_facture_texte }} ({{ $json.montant_texte }} TTC) reste impayée. Elle a maintenant {{ $json.jours_retard }} jours de retard.\n\nMerci de nous indiquer, en réponse à ce mail, la date à laquelle le règlement sera effectué.\n\nSans réponse de votre part, nous serons obligés de suspendre les prochaines livraisons.\n\nCordialement,\n\n{{ $('Réglages').first().json.signature }}",
        "options": {
          "appendAttribution": false,
          "senderName": "={{ $('Réglages').first().json.nom_entreprise }}"
        }
      }
    },
    {
      "id": "f6638c1a-73bc-4026-b171-3da4c535e8a8",
      "name": "Regrouper les clients à appeler",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1380,
        600
      ],
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "factures",
        "options": {}
      }
    },
    {
      "id": "44c71b90-4520-468e-824e-384df395f308",
      "name": "Alerte au dirigeant : à appeler",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1580,
        600
      ],
      "parameters": {
        "sendTo": "={{ $('Réglages').first().json.adresse_dirigeant }}",
        "subject": "=À appeler aujourd'hui : {{ $json.factures.length }} client{{ $json.factures.length > 1 ? 's' : '' }} en retard de paiement",
        "emailType": "text",
        "message": "=Bonjour,\n\n{{ $json.factures.length > 1 ? 'Ces ' + $json.factures.length + ' clients ne répondent pas' : 'Ce client ne répond pas' }} aux relances. Il faut {{ $json.factures.length > 1 ? 'les ' : \"l'\" }}appeler :\n\n{{ $json.factures.map(f => '- ' + f.client + ' : ' + f.montant_texte + ' TTC, facture ' + f.n_facture + ' échue le ' + f.date_echeance_texte + ' (' + f.jours_retard + ' jours de retard). Téléphone : ' + f.telephone).join('\\n') }}\n\nTotal à récupérer : {{ $json.factures.reduce((s, f) => s + Number(f.montant_ttc), 0).toLocaleString('fr-FR', { style: 'currency', currency: 'EUR' }) }} TTC.\n\nPlus aucun mail automatique ne partira vers {{ $json.factures.length > 1 ? 'ces clients' : 'ce client' }} pour {{ $json.factures.length > 1 ? 'ces factures' : 'cette facture' }}.",
        "options": {
          "appendAttribution": false,
          "senderName": "Relance des impayés"
        }
      }
    },
    {
      "id": "a75e2016-dcaa-474c-8b65-08b66e3da647",
