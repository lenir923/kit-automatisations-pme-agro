              "name": "date_facture_texte",
              "type": "string",
              "value": "={{ DateTime.fromISO($json.date_facture).setLocale('fr').toFormat('d MMMM') }}"
            },
            {
              "id": "ae26da3f-bc36-4600-b918-29c52fc4e4c7",
              "name": "date_echeance_texte",
              "type": "string",
              "value": "={{ DateTime.fromISO($json.date_echeance).setLocale('fr').toFormat('d MMMM') }}"
            },
            {
              "id": "86d66615-a66a-478e-b810-562e3a01dc25",
              "name": "echeance_texte",
              "type": "string",
              "value": "={{ Math.round($today.diff(DateTime.fromISO($json.date_echeance), 'days').days) === 1 ? 'hier' : 'le ' + DateTime.fromISO($json.date_echeance).setLocale('fr').toFormat('d MMMM') }}"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
