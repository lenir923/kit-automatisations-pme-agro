            {
              "id": "4d8d87df-42b4-463e-9046-3c474997fa13",
              "name": "niveau_a_envoyer",
              "type": "number",
              "value": "={{ (j => j >= $('Réglages').first().json.jours_appel ? 4 : j >= $('Réglages').first().json.jours_mail_ferme ? 3 : j >= $('Réglages').first().json.jours_rappel_direct ? 2 : 1)(Math.round($today.diff(DateTime.fromISO($json.date_echeance), 'days').days)) }}"
            },
            {
              "id": "a59abcfa-e750-4026-8000-d7eb25b7dd2e",
